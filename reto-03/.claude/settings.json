{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./fixtures/**)",
      "Write(./fixtures/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/verificacion.cjs marcar claude" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/verificacion.cjs verificar claude", "timeout": 300 }
        ]
      }
    ]
  }
}
